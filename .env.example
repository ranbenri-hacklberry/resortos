# ResortOS (formerly HotelOS) — local / Tailscale only. Do not commit real values.

# Senzey attendance bridge
SENZEY_USERNAME=
SENZEY_PASSWORD=
ATTENDANCE_API_KEY=

# PayFac webhook (required to accept webhooks)
PAYFAC_WEBHOOK_SECRET=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Bind address for the Express bridge (0.0.0.0 = LAN + Tailscale)
HOTELOS_BIND_HOST=127.0.0.1
HOTELOS_BIND_PORT=4038
HOTELOS_BRIDGE_URL=http://127.0.0.1:4038

# Cloudflare guest mailbox (Studio outbound only)
CHECKOUT_MAILBOX_URL=https://resortos.app
CHECKOUT_MAILBOX_SECRET=
# Reception desk page (https://resortos.app/desk) — Cloudflare Pages secret
HOTELOS_DESK_PIN=
HOTELOS_CASH_PIN=

# Grok Bot / WhatsApp guest-context (Cloudflare Pages secret on project `resortos`)
GROK_BOT_API_KEY=

# Kinorot GO scrape (Mac Studio cron) and guest check-in charges.
# Also set KINOROT_USER / KINOROT_PASSWORD as Cloudflare Pages secrets on project `resortos`.
KINOROT_USER=
KINOROT_PASSWORD=
# Optional: occupancy window, default 45
# KINOROT_DAYS=45
# Same-day new Kinorot arrivals → Micropay SMS (Max + Costa). Set 0 to disable.
# KINOROT_SAME_DAY_SMS=1
# KINOROT_SAME_DAY_SMS_PHONES=0506102416,0533932462

# Hyp Pay — Cloudflare Pages secrets on project `resortos` (never Vite / never the browser).
# PassP is the API password, not the portal login. Do not commit real values.
HYP_BASE_URL=https://pay.hyp.co.il/p/
# Terminal A · יתרות / תשלום מלא / צ׳ק־אין
HYP_A_MASOF=4502210929
HYP_A_KEY=
HYP_A_PASSP=
HYP_A_ZPASS=
HYP_A_AUTH_MODE=REFERER
# Terminal B · מקדמות
HYP_B_MASOF=4502315932
HYP_B_KEY=
HYP_B_PASSP=
HYP_B_ZPASS=
HYP_B_AUTH_MODE=PASSP
# CardCom ListTransactions + Low Profile iframe (office sheet "Cardcom") — not the charge KEY
# HYP_API_NAME=
# HYP_API_PASSWORD=
HYP_SUCCESS_URL=https://resortos.app/api/payments/hyp/success
# Legacy single-terminal aliases (treated as A if HYP_A_* is empty)
# HYP_MASOF=4502210929
# HYP_KEY=
# HYP_PASSP=

# Open Finance / Financy (server-side only — never expose to the browser)
OPEN_FINANCE_USER_ID=
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=

# Israeli bank scrapers (Studio Node only — never Vite / never the browser).
# Beinleumi checking: username/password from the office sheet. OTP off unless the bank asks.
BANK_SCRAPER_BEINLEUMI_USERNAME=
BANK_SCRAPER_BEINLEUMI_PASSWORD=
# BANK_SCRAPER_BEINLEUMI_OTP=1
# Max has two merchant portals (not the card site israeli-bank-scrapers uses):
#   מקדמות — https://businesslc.max.co.il
#   ניכויים / דוח זיכויים — Max Pay for businesses (separate login)
BANK_SCRAPER_MAX_ADVANCES_USERNAME=
BANK_SCRAPER_MAX_ADVANCES_PASSWORD=
BANK_SCRAPER_MAX_CLEARING_USERNAME=
BANK_SCRAPER_MAX_CLEARING_PASSWORD=
# Card site only (max.co.il), if needed later:
# BANK_SCRAPER_MAX_CARD_USERNAME=
# BANK_SCRAPER_MAX_CARD_PASSWORD=
# BANK_SCRAPER_SHOW_BROWSER=1

# Micropay SMS (Studio Node / Vite middleware only — never Vite public / never the browser).
# Token from https://site.micropay.co.il/api/ — "טוקנים לממשקים", SMS permission.
# MICROPAY_TOKEN=
# Approved sender (local digits or registered name), e.g. 0548076123
# MICROPAY_FROM=
# MICROPAY_URL=https://www.micropay.co.il/extApi/scheduleSms.php

# Frontend (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Reviews free product (Cloudflare Pages hotelos-reviews)
# Optional. Set as Pages env vars, not Vite:
# GOOGLE_CLIENT_ID=
# GOOGLE_MAPS_API_KEY=

# Staff login seed (created by server/migration_staff_auth.sql):
#   rani / hotelos   (MANAGER)
#   maya / hotelos   (HOUSEKEEPING)
# Change these after first login. Do not use production passwords in git.
# Optional: comma-separated hosts. Leave unset to allow Tailscale 100.x IPs.
# VITE_ALLOWED_HOSTS=localhost,.ts.net,.local
