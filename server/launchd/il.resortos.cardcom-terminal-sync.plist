<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>il.resortos.cardcom-terminal-sync</string>
  <key>WorkingDirectory</key>
  <string>/Users/rani/resortos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/rani/resortos/server/syncCardcomTerminal.js</string>
    <string>--force</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/cardcom-terminal-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cardcom-terminal-sync.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/rani</string>
    <key>USER</key>
    <string>rani</string>
    <key>LOGNAME</key>
    <string>rani</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CARDCOM_TERMINAL_SYNC_ENABLED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
