<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>il.resortos.checkout-reminder.report</string>
  <key>WorkingDirectory</key><string>/Users/rani/resortos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/rani/resortos/server/scheduledCheckoutReminder.js</string>
    <string>--mode=report</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/rani/resortos/logs/checkout-reminder.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/rani/resortos/logs/checkout-reminder.launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/rani</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CHECKOUT_REMINDER_DRY_RUN</key><string>1</string>
  </dict>
</dict>
</plist>
