{
  "name": "resortos-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local WhatsApp operations agent for ResortOS (Baileys + mlx-whisper + Ollama/Qwen)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "id-server": "tsx src/idValidation/idOcrServer.ts",
    "benchmark-id": "tsx scripts/benchmark-id-ocr.ts",
    "connect": "tsx scripts/connect.ts",
    "sync-cleaners": "tsx scripts/sync-cleaners.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "fluent-ffmpeg": "^2.1.3",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=20" }
}
